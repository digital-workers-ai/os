<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>stat-card</title>
<style>
@font-face { font-family: "Sans"; src: url("{{ fonts.sans }}") format("woff2"); font-weight: 400 700; }
@font-face { font-family: "Display"; src: url("{{ fonts.display }}") format("woff2"); font-weight: 500; }
html { font-size: calc({{ [width, height] | min }}px / 100); }
html, body { margin: 0; padding: 0; }
body { position: relative; width: {{ width }}px; height: {{ height }}px; overflow: hidden; background: {{ tokens.colors.wash }}; color: {{ tokens.colors.ink }}; font-family: "Sans", sans-serif; -webkit-font-smoothing: antialiased; }
.picture { position: absolute; inset: 0; background: url("{{ picture }}") center / cover no-repeat; }
.card { position: absolute; inset: 6rem; display: flex; flex-direction: column; box-sizing: border-box; padding: 7rem; background: {{ tokens.colors.paper }}; border: 0.25rem solid {{ tokens.colors.line }}; border-radius: 2.5rem; }
.body { display: flex; flex-direction: column; gap: 2rem; margin: auto 0; }
.stat { font-family: "Display", sans-serif; font-weight: 500; font-size: 26rem; line-height: 0.9; letter-spacing: -0.02em; color: {{ tokens.colors.accent }}; overflow-wrap: anywhere; }
.label { font-size: 6rem; font-weight: 700; line-height: 1.1; }
.support { margin: 1rem 0 0; font-size: 3.6rem; line-height: 1.35; color: {{ tokens.colors.muted }}; max-width: 34ch; }
.footer { display: flex; align-items: center; justify-content: space-between; padding-top: 3rem; border-top: 0.25rem solid {{ tokens.colors.line }}; }
.footer img { height: 3.2rem; }
.footer span { font-size: 2.4rem; color: {{ tokens.colors.muted }}; letter-spacing: 0.04em; }
.landscape .body { display: grid; grid-template-columns: auto 1fr; column-gap: 7rem; align-items: end; }
.landscape .stat { grid-row: 1 / span 2; }
.landscape .support { max-width: 44ch; }
</style>
</head>
<body class="{{ 'landscape' if width > height else 'portrait' }}">
{% if picture %}<div class="picture"></div>{% endif %}
<main class="card">
  <section class="body">
    <div class="stat">{{ slots.stat }}</div>
    <div class="label">{{ slots.label }}</div>
    <p class="support">{{ slots.support }}</p>
  </section>
  <footer class="footer">
    <img src="{{ logo }}" alt="Digital Workers">
    <span>DW-OS</span>
  </footer>
</main>
</body>
</html>
