{% import "layout-macro.j2" as ed %}

{% set SIZE_VARS = [['--size-headline', 1]] %}
{% set FMT = project.resolution %}
{% set w = 1920 if FMT == 'landscape' else 1080 %}
{% set h = {'portrait': 1920, 'four-five': 1350, 'square': 1080, 'landscape': 1080}[FMT] %}

{% macro _px(portrait, fourfive, square) %}{{ {'portrait': portrait, 'four-five': fourfive, 'square': square, 'landscape': portrait}[FMT] }}{% endmacro %}
{% set S = {
  'pad':       {'portrait': 88,   'four-five': 68,   'square': 56,   'landscape': 88},
  'lane':      {'portrait': 940,  'four-five': 720,  'square': 560,  'landscape': 940},
  'lane_full': {'portrait': 660,  'four-five': 530,  'square': 430,  'landscape': 660},
  'lane_tall': {'portrait': 880,  'four-five': 780,  'square': 560,  'landscape': 880},
  'card_h':    {'portrait': 132,  'four-five': 116,  'square': 104,  'landscape': 132},
  'card_gap':  {'portrait': 18,   'four-five': 16,   'square': 14,   'landscape': 18},
  'rows':      {'portrait': 3,    'four-five': 2,    'square': 2,    'landscape': 3},
  'cap_fs':    {'portrait': 27,   'four-five': 25,   'square': 24,   'landscape': 27},
  'cap_mb':    {'portrait': 30,   'four-five': 24,   'square': 20,   'landscape': 30},
  'close_mt':  {'portrait': 40,   'four-five': 32,   'square': 26,   'landscape': 40},
  'slab_py':   {'portrait': 30,   'four-five': 25,   'square': 21,   'landscape': 30},
  'slab_fs':   {'portrait': 29,   'four-five': 27,   'square': 25,   'landscape': 29},
  'stem':      {'portrait': 46,   'four-five': 38,   'square': 30,   'landscape': 46},
  'card_fs':   {'portrait': 30,   'four-five': 28,   'square': 27,   'landscape': 30},
  'card_r':    {'portrait': 30,   'four-five': 26,   'square': 24,   'landscape': 30},
  'card_px':   {'portrait': 34,   'four-five': 30,   'square': 28,   'landscape': 34},
} %}

{% set PAD = S['pad'][FMT] %}
{% set BAR_W = 812 %}

{% set LANE_H = S['lane'][FMT] %}

{% set LANE_H_FULL = S['lane_full'][FMT] %}

{% set LANE_H_TALL = S['lane_tall'][FMT] %}

{% set LANE_TALL_KEEP = 0.72 %}
{% set LANE_H_TALL_TRIM = (LANE_H_TALL * LANE_TALL_KEEP) | round | int %}
{% set TALL_TRIM_PAD = ((LANE_H_TALL - LANE_H_TALL_TRIM) / 2) | round | int %}

{% set FALL = 1180 %}
{% set CYCLE = 9.0 %}

{% set GHOSTS = 7 %}

{% set GHOST_GAP_PX = 42 %}
{% set GHOST_STEP = (GHOST_GAP_PX * CYCLE / FALL) | round(4) %}

{% set SOURCES = [
  ('card',         'subscription', 62),
  ('mail',         'email',        40),
  ('bag',          'purchase',     26),
  ('repeat',       'share',        72),
  ('userplus',     'follow',       56),
  ('thumb',        'like',         15),
  ('phone',        'call',         30),
  ('click',        'ad click',     48),
  ('star',         'review',       68),
  ('instagram',    'comment',      22),
  ('message',      'message',      36),
  ('calendar',     'booking',      80),
] %}

{% set ICONS = {
  'instagram': '<rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>',
  'repeat': '<path d="m2 9 3-3 3 3"/><path d="M13 18H7a2 2 0 0 1-2-2V6"/><path d="m22 15-3 3-3-3"/><path d="M11 6h6a2 2 0 0 1 2 2v10"/>',
  'mail': '<path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7"/><rect x="2" y="4" width="20" height="16" rx="2"/>',
  'card': '<rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/>',
  'thumb': '<path d="M7 10v12"/><path d="M15 5.88 14 10h5.83a2 2 0 0 1 1.92 2.56l-2.33 8A2 2 0 0 1 17.5 22H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h2.76a2 2 0 0 0 1.79-1.11L12 2a3.13 3.13 0 0 1 3 3.88Z"/>',
  'calendar': '<path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/><path d="m9 16 2 2 4-4"/>',
  'click': '<path d="M14 4.1 12 6"/><path d="m5.1 8-2.9-.8"/><path d="m6 12-1.9 2"/><path d="M7.2 2.2 8 5.1"/><path d="M9.037 9.69a.498.498 0 0 1 .653-.653l11 4.5a.5.5 0 0 1-.074.949l-4.349 1.041a1 1 0 0 0-.74.739l-1.04 4.35a.5.5 0 0 1-.95.074z"/>',
  'phone': '<path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384"/>',
  'star': '<path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"/>',
  'message': '<path d="M2.992 16.342a2 2 0 0 1 .094 1.167l-1.065 3.29a1 1 0 0 0 1.236 1.168l3.413-.998a2 2 0 0 1 1.099.092 10 10 0 1 0-4.777-4.719"/>',
  'userplus': '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" x2="19" y1="8" y2="14"/><line x1="22" x2="16" y1="11" y2="11"/>',
  'bag': '<path d="M16 10a4 4 0 0 1-8 0"/><path d="M3.103 6.034h17.794"/><path d="M3.4 5.467a2 2 0 0 0-.4 1.2V20a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6.667a2 2 0 0 0-.4-1.2l-2-2.667A2 2 0 0 0 17 2H7a2 2 0 0 0-1.6.8z"/>',
} %}

{% set CARD_H = S['card_h'][FMT] %}
{% set CARD_GAP = S['card_gap'][FMT] %}
{% set PITCH = CARD_H + CARD_GAP %}

{% set BRIEF_HOLD_REFERENCE = 2.6 %}
{% set BRIEF_SLIDE = 0.52 %}

{% set FEED_H = 116 %}
{% set FEED_GAP = 14 %}
{% set FEED_PITCH = FEED_H + FEED_GAP %}

{% set MAIL_H = 296 %}
{% set MAIL_STEP = 66 %}
{% set BRIEF_WINDOW = S['rows'][FMT] %}

{% macro icon(key, size) -%}
<svg class="ai-ico" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none"
     stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">{{ ICONS[key] }}</svg>
{%- endmacro %}

{% macro stream(p, compact=false) -%}
      <div class="ai-lane{% if compact %} ai-lane--compact{% endif %}" id="{{ p }}-lane">
{% for key, label, lane in SOURCES %}

{% set si = loop.index0 %}
        <div class="ai-src" style="left: {{ lane }}%">
{% for g in range(GHOSTS) %}
          <span class="ai-ghost" id="{{ p }}-c{{ si }}-{{ g }}"
                data-phase="{{ (((si * (CYCLE / SOURCES | length)) - (g * GHOST_STEP)) % CYCLE / CYCLE * FALL) | round(2) }}"
                style="z-index: {{ GHOSTS - g }}">
            <span class="ai-chip{% if g %} is-ghost{% endif %}"
                  style="opacity: {{ (0.88 ** g) | round(3) }}; transform: translate(-50%, -50%) scale({{ (1 - g * 0.01) | round(3) }})">
              {{ icon(key, 34) }}<span class="ai-chip-label">{{ label }}</span>
            </span>
          </span>
{% endfor %}
        </div>
{% endfor %}
      </div>
{%- endmacro %}

{% macro slab(p, label, stem=true) -%}
      <div class="ai-slab-wrap">
        <div class="ai-slab" id="{{ p }}-slab">{{ label }}</div>
{% if stem %}
        <div class="ai-stem" id="{{ p }}-stem"></div>
{% endif %}
      </div>
{%- endmacro %}

{% macro brief_card(b) -%}
        <div class="ai-card">
{% if b.kind == 'alert' %}
          <span class="ai-card-flag is-alert">!</span>
{% else %}
          <span class="ai-card-flag{% if b.kind == 'up' %} is-up{% else %} is-down{% endif %}">{{ '▲' if b.kind == 'up' else '▼' }} {{ b.stat }}</span>
{% endif %}
          <span class="ai-card-text">{{ b.text }}</span>
        </div>
{%- endmacro %}

{% macro ticker(p, briefs) -%}
      <div class="ai-window">
        <div class="ai-list" id="{{ p }}-list" style="top: {{ -(briefs | length) * PITCH }}px">
{% for _pass in range(2) %}
{% for b in briefs %}
{{ brief_card(b) }}
{% endfor %}
{% endfor %}
        </div>
      </div>
{%- endmacro %}

{% macro feed(p, findings) -%}
      <div class="ai-feed" id="{{ p }}-feed" style="--copy-h: {{ (findings | length) * FEED_PITCH }}px">
        <div class="ai-feed-list" id="{{ p }}-feedlist">
{% for _pass in range(2) %}
{% for it in findings %}
          <div class="ai-feed-row is-{{ it.severity }}">
            <div class="ai-feed-text">{{ it.text }}</div>
{% if it.meta %}
            <div class="ai-feed-meta">{{ it.meta }}</div>
{% endif %}
          </div>
{% endfor %}
{% endfor %}
        </div>
      </div>
{%- endmacro %}

{% macro mail_stack(p, sender, cards) -%}
      <div class="ai-mailstack" id="{{ p }}-stack"
           style="height: {{ MAIL_H + (cards | length - 1) * MAIL_STEP }}px">
{% for card in cards %}
        <div class="ai-mail" id="{{ p }}-mail{{ loop.index0 }}"
             style="top: {{ loop.index0 * MAIL_STEP }}px; z-index: {{ loop.index }}">
          <div class="ai-mail-top">
            <span class="ai-mail-from">{{ sender }}</span>
            <span class="ai-mail-date">{{ card.date }}</span>
          </div>
          <div class="ai-mail-subject">{{ card.subject }}</div>
          <ul class="ai-mail-lines">
{% for line in card.lines %}
            <li>{{ line }}</li>
{% endfor %}
          </ul>
        </div>
{% endfor %}
      </div>
{%- endmacro %}

{% macro headline(text, cls, id) -%}
        <div class="{{ cls }}" id="{{ id }}">
{% for line in text.split('\n') %}
          <span class="ai-line"><span class="ai-line-in" data-line>{{ line }}</span></span>
{% endfor %}
        </div>
{%- endmacro %}

{% macro scene_body(scene, idx, p) -%}
{% set c = scene.content %}
{% if scene.type == 'hook' %}
      <div class="ai-frame ai-frame--centre copy-block" id="{{ p }}" {{ ed.layout_style(scene, SIZE_VARS, 'center') }}>
        <div class="ai-eyebrow" id="{{ p }}-eyebrow">{{ c.eyebrow }}</div>
{{ headline(c.headline, 'ai-headline', p ~ '-headline') }}
      </div>

{% elif scene.type == 'statement' %}
      <div class="ai-frame ai-frame--centre copy-block" id="{{ p }}" {{ ed.layout_style(scene, SIZE_VARS, 'center') }}>
{% if c.eyebrow %}
        <div class="ai-eyebrow" id="{{ p }}-eyebrow">{{ c.eyebrow }}</div>
{% endif %}
{{ headline(c.headline, 'ai-headline ai-headline--sm', p ~ '-headline') }}
        <p class="ai-body" id="{{ p }}-body">{{ c.body }}</p>
      </div>

{% elif scene.type == 'intake' %}
      <div class="ai-frame ai-frame--intake" id="{{ p }}">
        <div class="ai-cap copy-block" id="{{ p }}-cap" {{ ed.layout_style(scene, [], 'center', 'caption', root=true) }}>{{ c.caption }}</div>
{{ stream(p) }}
{{ slab(p, c.label, stem=false) }}
      </div>

{% elif scene.type == 'briefing' %}
      <div class="ai-frame ai-frame--brief" id="{{ p }}">
        <div class="ai-cap copy-block" id="{{ p }}-cap" {{ ed.layout_style(scene, [], 'center', 'caption', root=true) }}>{{ c.caption }}</div>
{{ slab(p, c.label) }}
{{ ticker(p, c.briefs) }}
      </div>

{% elif scene.type == 'pitch' %}

      <div class="ai-frame ai-frame--centre ai-pitch ai-pitch--v{{ scene.variant }}{% if scene.dark %} ai-dark{% endif %} copy-block" id="{{ p }}" {{ ed.layout_style(scene, SIZE_VARS, 'center') }}>
        <div class="ai-pitch-inner">
          <div class="ai-eyebrow" id="{{ p }}-eyebrow">{{ c.eyebrow }}</div>
{{ headline(c.headline, 'ai-headline ai-headline--pitch', p ~ '-headline') }}
{% if c.bullets %}

          <ul class="ai-pitch-list" id="{{ p }}-bullets">
{% for item in c.bullets %}
            <li><span>{{ item }}</span></li>
{% endfor %}
          </ul>
          <p class="ai-pitch-note" id="{{ p }}-copy">{{ c.body }}</p>
{% else %}
          <p class="ai-pitch-copy" id="{{ p }}-copy">{{ c.body }}</p>
{% endif %}
          <div class="ai-pills" id="{{ p }}-pills">
            <span class="ai-pill is-solid">{{ c.primary }}</span>
          </div>
        </div>
      </div>

{% elif scene.type == 'mailstack' %}

      <div class="ai-frame ai-frame--funnel ai-funnel ai-funnel--v{{ scene.variant }}{% if scene.dark %} ai-dark{% endif %}" id="{{ p }}">
        <div class="ai-funnel-inner">
{% if c.caption %}
          <div class="ai-cap copy-block" id="{{ p }}-cap" {{ ed.layout_style(scene, [], 'center', 'caption', root=true) }}>{{ c.caption }}</div>
{% endif %}
{{ stream(p, compact=true) }}
{{ slab(p, c.label) }}
{{ mail_stack(p, c.sender, c.cards) }}
        </div>
      </div>

{% elif scene.type == 'feed' %}

      <div class="ai-frame ai-frame--feed ai-feed-scene{% if scene.dark %} ai-dark{% endif %}" id="{{ p }}">
{% if c.caption %}
        <div class="ai-cap copy-block" id="{{ p }}-cap" {{ ed.layout_style(scene, [], 'center', 'caption', root=true) }}>{{ c.caption }}</div>
{% endif %}
        <div class="ai-feed-head" id="{{ p }}-head">{{ c.title }}</div>
{{ feed(p, c.findings) }}
      </div>

{% elif scene.type == 'funnel' %}

      <div class="ai-frame ai-frame--funnel ai-funnel ai-funnel--v{{ scene.variant }}{% if scene.dark %} ai-dark{% endif %}" id="{{ p }}">
        <div class="ai-funnel-inner">
{% if c.caption %}
          <div class="ai-cap copy-block" id="{{ p }}-cap" {{ ed.layout_style(scene, [], 'center', 'caption', root=true) }}>{{ c.caption }}</div>
{% endif %}
          <div class="ai-funnel-mid">
{{ stream(p, compact=true) }}
{{ slab(p, c.label) }}
{{ ticker(p, c.briefs) }}
          </div>
{% if c.closer %}
          <div class="ai-closer copy-block" id="{{ p }}-closer" {{ ed.layout_style(scene, [], 'center', 'closer') }}>{{ c.closer }}</div>
{% endif %}
        </div>
      </div>

{% elif scene.type == 'cta' %}
      <div class="ai-frame ai-frame--centre copy-block" id="{{ p }}" {{ ed.layout_style(scene, SIZE_VARS, 'center') }}>
{{ headline(c.headline, 'ai-headline ai-headline--sm', p ~ '-headline') }}
        <div class="ai-pills" id="{{ p }}-pills">
          <span class="ai-pill is-solid">{{ c.primary }}</span>
{% if c.secondary %}
          <span class="ai-pill is-ghost">{{ c.secondary }}</span>
{% endif %}
        </div>
      </div>
{% endif %}
{%- endmacro %}

{% macro fall_timeline(p, base, dur) -%}

{% set reps = (dur / CYCLE) | round(0, 'ceil') | int %}
      [...document.querySelectorAll('#{{ p }}-lane .ai-ghost')].forEach(function (el) {
        var phase = parseFloat(el.dataset.phase) || 0;
        tl.fromTo(el, { y: 0 }, {
          y: {{ FALL }}, duration: {{ CYCLE }}, ease: 'none', repeat: {{ reps }},
          modifiers: { y: function (v) { return ((parseFloat(v) + phase) % {{ FALL }}) + 'px'; } },
        }, {{ base }});
      });
{%- endmacro %}

{% macro tick_timeline(p, base, dur, n) -%}
{% set loop_len = CYCLE if n <= 4 else 2 * CYCLE %}
{% set hold = (loop_len / n) %}
{% set reps = (dur / loop_len) | round(0, 'ceil') | int %}
      {
        var list{{ p }} = document.getElementById('{{ p }}-list');
        var tick{{ p }} = gsap.timeline({ repeat: {{ reps }} });
        for (var k = 0; k < {{ n }}; k++) {
          tick{{ p }}.to(list{{ p }}, {
            y: (k + 1) * {{ PITCH }}, duration: {{ BRIEF_SLIDE }}, ease: 'power2.out',
          }, k * {{ hold | round(4) }});
        }
        tick{{ p }}.to({}, { duration: 0 }, {{ loop_len }});
        gsap.set(list{{ p }}, { y: 0 });
        tl.add(tick{{ p }}, {{ base }});
      }
{%- endmacro %}

{% macro reveal(p, at, stagger=0.12) -%}
      tl.fromTo('#{{ p }} .ai-line-in',
        { yPercent: 115 },
        { yPercent: 0, duration: 0.78, ease: 'power3.out', stagger: {{ stagger }} },
        {{ at }});
{%- endmacro %}

{% macro fade_up(sel, at, dist=28, dur=0.62) -%}
      tl.fromTo('{{ sel }}',
        { opacity: 0, y: {{ dist }} },
        { opacity: 1, y: 0, duration: {{ dur }}, ease: 'power2.out' },
        {{ at }});
{%- endmacro %}

{% macro slab_in(p, at) -%}
      tl.fromTo('#{{ p }}-slab',
        { scaleY: 0.12, opacity: 1 },
        { scaleY: 1, duration: 0.5, ease: 'power3.out' },
        {{ at }});
      if (document.getElementById('{{ p }}-stem')) {
        tl.fromTo('#{{ p }}-stem',
          { scaleY: 0 },
          { scaleY: 1, duration: 0.3, ease: 'power2.out' },
          {{ at + 0.42 }});
      }
{%- endmacro %}

{% macro scene_timeline(scene, idx, p, base, dur, reset) -%}
{% set c = scene.content %}
{% if scene.type == 'hook' %}
{{ fade_up('#' ~ p ~ '-eyebrow', base + 0.1, 18) }}
{{ reveal(p ~ '-headline', base + 0.28) }}

{% elif scene.type == 'statement' %}
{% if c.eyebrow %}
{{ fade_up('#' ~ p ~ '-eyebrow', base + 0.1, 18) }}
{% endif %}
{{ reveal(p ~ '-headline', base + 0.24) }}
{{ fade_up('#' ~ p ~ '-body', base + 0.72, 24, 0.7) }}

{% elif scene.type == 'intake' %}

{{ fall_timeline(p, base, dur) }}
{{ slab_in(p, base + 0.55) }}
{{ fade_up('#' ~ p ~ '-cap', base + 1.0, 20) }}

{% elif scene.type == 'briefing' %}
{{ slab_in(p, base + 0.2) }}
{{ fade_up('#' ~ p ~ '-cap', base + 0.1, 20) }}
{{ tick_timeline(p, base + 0.5, dur - 0.5, c.briefs | length) }}
{{ fade_up('#' ~ p ~ ' .ai-window', base + 0.62, 26, 0.7) }}

{% elif scene.type == 'pitch' %}

{{ fade_up('#' ~ p ~ '-eyebrow', base + 0.1, 18) }}
{{ reveal(p ~ '-headline', base + 0.26) }}
{% if c.bullets %}
      tl.fromTo('#{{ p }}-bullets li',
        { opacity: 0, y: 20 },
        { opacity: 1, y: 0, duration: 0.5, ease: 'power2.out', stagger: 0.26 },
        {{ base + 0.95 }});
{{ fade_up('#' ~ p ~ '-copy', base + 0.95 + 0.26 * (c.bullets | length) + 0.3, 22, 0.6) }}
{{ fade_up('#' ~ p ~ '-pills', base + 0.95 + 0.26 * (c.bullets | length) + 1.0, 26, 0.62) }}
{% else %}
{{ fade_up('#' ~ p ~ '-copy', base + 1.0, 24, 0.68) }}
{{ fade_up('#' ~ p ~ '-pills', base + 1.72, 26, 0.62) }}
{% endif %}

{% elif scene.type == 'mailstack' %}

{{ fall_timeline(p, base, dur) }}
{% for card in c.cards %}
      tl.fromTo('#{{ p }}-mail{{ loop.index0 }}',
        { opacity: 0, y: 54, scale: 0.97 },
        { opacity: 1, y: 0, scale: 1, duration: 0.62, ease: 'power3.out' },
        {{ (base + 0.9 + loop.index0 * 1.7) | round(3) }});
{% endfor %}

{% elif scene.type == 'feed' %}

{% set n = c.findings | length %}
{% set reps = (dur / CYCLE) | round(0, 'ceil') | int %}
      tl.fromTo('#{{ p }}-feedlist',
        { y: 0 },
        { y: {{ -(n * FEED_PITCH) }}, duration: {{ CYCLE }}, ease: 'none', repeat: {{ reps }} },
        {{ base }});

{% elif scene.type == 'funnel' %}

{{ fall_timeline(p, base, dur) }}
{{ tick_timeline(p, base, dur, c.briefs | length) }}

{% elif scene.type == 'cta' %}
{{ reveal(p ~ '-headline', base + 0.15) }}
{{ fade_up('#' ~ p ~ '-pills', base + 0.72, 26, 0.66) }}
{% endif %}
{%- endmacro %}

<!doctype html>
<html lang="en" data-resolution="{{ project.resolution }}">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width={{ w }}, height={{ h }}" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family={{ theme.font_display | replace(' ', '+') }}:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family={{ theme.font_body | replace(' ', '+') }}:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
{% if preview %}
    <link href="https://fonts.googleapis.com/css2?family=Science+Gothic:wght@300;500&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
{% endif %}
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js"></script>
    <style>

      .copy-block {
        translate: var(--nudge-x, 0px) var(--nudge-y, 0px);
        scale: var(--nudge-s, 1);
      }

      * { margin: 0; padding: 0; box-sizing: border-box; }

      :root {
        --ink: {{ theme.color_ink }};
        --bg: {{ theme.color_bg }};
        --accent: {{ theme.color_accent }};
        --muted: {{ theme.color_muted }};
        --cream: {{ theme.color_cream }};
        --tan: {{ theme.color_tan }};
        --card: {{ theme.color_card }};
        --up: {{ theme.color_positive }};

        --size-headline: 116px;
      }

      body { background: var(--bg); }
      .scene-solid { background: var(--bg); }

      .ai-frame {
        position: absolute; inset: 0;
        background: var(--bg);
        padding: {{ PAD }}px;
        font-family: '{{ theme.font_body }}', system-ui, sans-serif;
        color: var(--ink);
        overflow: hidden;
      }
      .ai-frame--centre {
        display: flex; flex-direction: column; justify-content: center;
        padding-left: {{ PAD }}px; padding-right: {{ PAD }}px;
      }

      .ai-eyebrow {
        color: var(--accent);
        font-size: 30px; font-weight: 500;
        letter-spacing: 0.16em; text-transform: uppercase;
        margin-bottom: 44px;
      }
      .ai-headline {
        font-family: '{{ theme.font_display }}', system-ui, sans-serif;

        font-weight: 400;
        font-size: var(--size-headline);
        line-height: var(--nudge-lh, 1.06);
        letter-spacing: -0.022em;
        color: var(--ink);
      }
      .ai-headline--sm { --size-headline: 78px; }

      .ai-headline--pitch { --size-headline: 96px; }

      .ai-line { display: block; overflow: hidden; }
      .ai-line-in { display: block; will-change: transform; }

      .ai-body {
        margin-top: 40px;
        font-size: 38px; line-height: 1.52; color: var(--muted);
        max-width: 860px;
      }

      .ai-pitch-copy {
        margin-top: 44px; max-width: 830px;
        font-size: 36px; line-height: 1.5; color: var(--muted);
      }

      .ai-pitch-list { list-style: none; margin-top: 44px; max-width: 830px; }
      .ai-pitch-list li {
        position: relative; padding-left: 44px;
        font-size: 36px; line-height: 1.45; color: var(--ink);
      }
      .ai-pitch-list li + li { margin-top: 20px; }
      .ai-pitch-list li::before {
        content: ""; position: absolute; left: 8px; top: 21px;
        width: 12px; height: 12px; border-radius: 50%;
        background: var(--accent);
      }
      .ai-pitch-note {
        margin-top: 40px; max-width: 830px;
        font-size: 34px; line-height: 1.5; color: var(--muted);
      }

      .ai-frame--centre .ai-pills { margin-top: 66px; }

      .ai-mailstack { position: relative; width: {{ BAR_W }}px; margin: 0 auto; z-index: 5; }
      .ai-mail {
        position: absolute; left: 0; right: 0;
        height: {{ MAIL_H }}px;
        padding: 26px 32px;
        background: var(--card); border: 1px solid var(--cream);
        border-radius: 26px;
        box-shadow: 0 -6px 30px rgba(26, 26, 26, 0.10);
      }
      .ai-mail-top {
        display: flex; justify-content: space-between; align-items: baseline;
        padding-bottom: 16px; border-bottom: 1px solid var(--cream);
      }
      .ai-mail-from {
        font-size: 22px; font-weight: 600; letter-spacing: 0.11em;
        text-transform: uppercase; color: var(--accent);
      }
      .ai-mail-date { font-size: 22px; color: var(--muted); }
      .ai-mail-subject {
        margin-top: 20px; font-size: 33px; line-height: 1.2; color: var(--ink);
      }
      .ai-mail-lines { list-style: none; margin-top: 18px; }
      .ai-mail-lines li {
        position: relative; padding-left: 26px;
        font-size: 26px; line-height: 1.35; color: var(--muted);
      }
      .ai-mail-lines li + li { margin-top: 10px; }
      .ai-mail-lines li::before {
        content: ""; position: absolute; left: 2px; top: 13px;
        width: 8px; height: 8px; border-radius: 50%; background: var(--tan);
      }

      .ai-dark .ai-mail { box-shadow: none; }

      .ai-frame--feed { display: flex; flex-direction: column; justify-content: center; }
      .ai-feed-head {
        font-size: 60px; font-weight: 400; letter-spacing: -0.02em;
        color: var(--ink); margin-bottom: 40px;
      }
      .ai-feed {
        position: relative; overflow: hidden;

        height: var(--copy-h);
        -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 90px,
                            #000 calc(100% - 150px), transparent 100%);
        mask-image: linear-gradient(to bottom, transparent 0, #000 90px,
                    #000 calc(100% - 150px), transparent 100%);
      }
      .ai-feed-list { position: absolute; inset: 0 0 auto 0; will-change: transform; }

      .ai-feed-row {
        position: relative;
        height: {{ FEED_H }}px; margin-bottom: {{ FEED_GAP }}px;
        padding: 0 30px 0 34px;
        display: flex; flex-direction: column; justify-content: center; gap: 7px;
        background: var(--card); border: 1px solid var(--cream);
        border-radius: 22px;
      }
      .ai-feed-row::before {
        content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 6px;
        border-radius: 0 4px 4px 0;
      }

      .ai-feed-row.is-high::before { background: var(--accent); }
      .ai-feed-row.is-medium::before { background: var(--tan); }
      .ai-feed-text { font-size: 30px; line-height: 1.25; color: var(--ink); }
      .ai-feed-meta {
        font-size: 21px; letter-spacing: 0.09em; text-transform: uppercase;
        color: var(--muted);
      }

      .ai-funnel-inner { width: 100%; }

      .ai-funnel-mid { display: flex; flex-direction: column; justify-content: center; }

      .ai-funnel--v2 .ai-cap { display: none; }

      .ai-funnel--v3 .ai-slab {
        width: calc(100% + {{ PAD * 2 }}px); margin: 0 -{{ PAD }}px;
        border-radius: 0;
      }

      .ai-funnel--v4 .ai-funnel-inner {
        background: var(--card); border: 1px solid var(--cream);
        border-radius: 48px; padding: 48px 36px 56px;
      }
      .ai-funnel--v4 .ai-lane { margin: 0; width: 100%; }
      .ai-funnel--v4 .ai-slab, .ai-funnel--v4 .ai-window { width: 700px; }
      .ai-funnel--v4 .ai-card { background: var(--bg); }

      .ai-funnel--v5 .ai-lane--compact { height: {{ LANE_H_TALL_TRIM }}px; }
      .ai-funnel--v5 .ai-window { --rows: 2; }

      .ai-funnel--v5 .ai-funnel-mid { padding: {{ TALL_TRIM_PAD }}px 0; }

      .ai-funnel--v6 .ai-lane--compact { height: 470px; }
      .ai-funnel--v6 .ai-window { --rows: 2; }
      .ai-funnel--v6 .ai-card-text, .ai-funnel--v6 .ai-card-flag { font-size: 34px; }

      .ai-funnel--v7 .ai-slab { border-radius: 999px; padding-left: 48px; padding-right: 48px; }

      .ai-funnel--v8 .ai-slab, .ai-funnel--v8 .ai-card { border-radius: 0; }
      .ai-funnel--v8 .ai-chip { border-radius: 4px; }

      .ai-funnel--v9 .ai-slab { background: var(--accent); color: #ffffff; }
      .ai-funnel--v9 .ai-stem { background: var(--accent); }

      .ai-funnel--v10 .ai-slab, .ai-funnel--v10 .ai-window { width: 660px; }
      .ai-funnel--v10 .ai-card { border-radius: 22px; padding: 0 26px; }
      .ai-funnel--v10 .ai-card-text, .ai-funnel--v10 .ai-card-flag { font-size: 27px; }

      .ai-pitch-inner { width: 100%; }
      .ai-pitch-list li span { display: inline-block; }

      .ai-pitch--v2 { text-align: center; }
      .ai-pitch--v2 .ai-pitch-list li { padding-left: 0; }
      .ai-pitch--v2 .ai-pitch-list li::before { display: none; }
      .ai-pitch--v2 .ai-pitch-list,
      .ai-pitch--v2 .ai-pitch-note { margin-left: auto; margin-right: auto; }
      .ai-pitch--v2 .ai-pills { justify-content: center; }

      .ai-pitch--v3 .ai-pitch-inner {
        background: var(--card); border: 1px solid var(--cream);
        border-radius: 44px; padding: 76px 68px 84px;
        box-shadow: 0 24px 60px rgba(26, 26, 26, 0.07);
      }
      .ai-pitch--v3 { --size-headline: 82px; }
      .ai-pitch--v3 .ai-pitch-list { max-width: none; }

      .ai-pitch--v4 .ai-pitch-list { counter-reset: aios-b; }
      .ai-pitch--v4 .ai-pitch-list li { padding-left: 90px; }
      .ai-pitch--v4 .ai-pitch-list li::before {
        counter-increment: aios-b;
        content: counter(aios-b, decimal-leading-zero);
        background: none; border-radius: 0;
        left: 0; top: 0; width: auto; height: auto;
        font-size: 30px; font-weight: 600; color: var(--accent);
        letter-spacing: 0.04em;
      }

      .ai-pitch--v5 .ai-eyebrow {
        display: inline-block;
        background: var(--ink); color: var(--card);
        border-radius: 14px; padding: 16px 26px;
        font-size: 25px; letter-spacing: 0.13em;
      }

      .ai-pitch--v6 .ai-pitch-list li {
        padding: 26px 0; border-bottom: 1px solid var(--cream);
      }
      .ai-pitch--v6 .ai-pitch-list li:first-child { border-top: 1px solid var(--cream); }
      .ai-pitch--v6 .ai-pitch-list li + li { margin-top: 0; }
      .ai-pitch--v6 .ai-pitch-list li::before { display: none; }

      .ai-pitch--v7 .ai-pitch-inner { display: flex; flex-direction: column; }
      .ai-pitch--v7 .ai-eyebrow { order: 1; }
      .ai-pitch--v7 .ai-headline { order: 2; }
      .ai-pitch--v7 .ai-pitch-note {
        order: 3; margin-top: 40px;
        font-size: 40px; line-height: 1.4; color: var(--ink);
      }
      .ai-pitch--v7 .ai-pitch-list { order: 4; margin-top: 38px; }
      .ai-pitch--v7 .ai-pitch-list li { font-size: 31px; color: var(--muted); }
      .ai-pitch--v7 .ai-pitch-list li::before { top: 18px; width: 10px; height: 10px; }
      .ai-pitch--v7 .ai-pills { order: 5; }

      .ai-pitch--v8 .ai-pitch-list {
        border: 1px solid var(--tan); border-radius: 32px;
        padding: 44px 46px; max-width: 880px;
      }

      .ai-pitch--v9 .ai-pitch-list {
        display: flex; flex-direction: column; align-items: flex-start; gap: 20px;
      }
      .ai-pitch--v9 .ai-pitch-list li {
        padding: 16px 32px; margin: 0;
        background: var(--card); border: 1px solid var(--cream);
        border-radius: 999px; font-size: 32px;
        box-shadow: 0 3px 10px rgba(26, 26, 26, 0.06);
      }
      .ai-pitch--v9 .ai-pitch-list li::before { display: none; }

      .ai-dark {
        --bg: #1A1A1A;
        --ink: #F5F4ED;
        --card: #232322;
        --cream: #38352F;
        --muted: #ADAB9E;
        --tan: #55514A;

        --up: #3DD68C;
      }

      .ai-dark .ai-chip, .ai-dark .ai-card { box-shadow: none; }

      .ai-dark .ai-chip { background: #2c2c28; border-color: #474338; }

      .ai-dark .ai-pitch-inner,
      .ai-dark .ai-pitch-list li { box-shadow: none; }

      .ai-dark .ai-pill.is-solid { background: var(--accent); color: #ffffff; }
      .ai-dark .ai-pill.is-ghost { border-color: var(--tan); color: var(--ink); }

      .ai-pitch--v10 .ai-pitch-list { max-width: 880px; }
      .ai-pitch--v10 .ai-pitch-list li {
        padding: 30px 34px; margin: 0 0 16px;
        background: var(--card); border: 1px solid var(--cream);
        border-radius: 26px; font-size: 32px;
        box-shadow: 0 8px 26px rgba(26, 26, 26, 0.05);
      }
      .ai-pitch--v10 .ai-pitch-list li::before {
        left: 0; top: 0; bottom: 0; width: 6px; height: auto;
        border-radius: 0 4px 4px 0; background: var(--accent);
      }

      .ai-closer {
        margin-top: {{ S['close_mt'][FMT] }}px; text-align: center;
        color: var(--accent);
        font-size: {{ S['cap_fs'][FMT] }}px; font-weight: 500;
        letter-spacing: 0.16em; text-transform: uppercase;
        line-height: 1.45;
        text-wrap: balance;

        padding-left: 0.16em;
      }

      .ai-cap {
        color: var(--accent);
        font-size: {{ S['cap_fs'][FMT] }}px; font-weight: 500;
        letter-spacing: 0.16em; text-transform: uppercase;
        text-align: center;
        margin-bottom: {{ S['cap_mb'][FMT] }}px;

        line-height: 1.45;
        text-wrap: balance;

        padding-left: 0.16em;
      }

      .ai-lane {
        position: relative;

        margin: 0 -{{ PAD }}px;
        width: calc(100% + {{ PAD * 2 }}px); height: {{ LANE_H }}px;
        overflow: hidden;
        -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 120px);
        mask-image: linear-gradient(to bottom, transparent 0, #000 120px);
      }
      .ai-lane--compact { height: {{ LANE_H_FULL }}px; }
      .ai-src { position: absolute; top: 0; }
      .ai-ghost { position: absolute; display: block; will-change: transform; }
      .ai-chip {
        display: flex; align-items: center; gap: 14px;
        white-space: nowrap;
        background: var(--card);
        border: 1px solid var(--cream);
        border-radius: 999px;
        padding: 15px 30px 15px 23px;
        font-size: 34px; color: var(--ink);
        box-shadow: 0 3px 10px rgba(26, 26, 26, 0.06);
      }

      .ai-chip.is-ghost { box-shadow: none; }
      .ai-chip.is-ghost .ai-ico,
      .ai-chip.is-ghost .ai-chip-label { visibility: hidden; }
      .ai-ico { color: var(--accent); flex: none; }
      .ai-chip-label { line-height: 1; }

      .ai-slab-wrap {
        position: relative; z-index: 5;
        display: flex; flex-direction: column; align-items: center;
      }
      .ai-slab {
        width: {{ BAR_W }}px;
        background: var(--ink); color: var(--card);
        border-radius: 20px;
        padding: {{ S['slab_py'][FMT] }}px 36px;
        text-align: center;
        font-size: {{ S['slab_fs'][FMT] }}px; font-weight: 600;
        letter-spacing: 0.13em; text-transform: uppercase;

        text-indent: 0.13em;
        transform-origin: center;
      }
      .ai-stem {
        width: 2px; height: {{ S['stem'][FMT] }}px; background: var(--tan);
        transform-origin: top center;
      }

      .ai-window {
        position: relative; z-index: 5;
        width: {{ BAR_W }}px; margin: 0 auto;
        height: calc(var(--rows, {{ BRIEF_WINDOW }}) * {{ PITCH }}px - {{ CARD_GAP }}px);
        overflow: hidden;
      }
      .ai-list { position: absolute; left: 0; right: 0; will-change: transform; }
      .ai-card {
        display: flex; align-items: center; gap: 18px;
        height: {{ CARD_H }}px; margin-bottom: {{ CARD_GAP }}px;
        background: var(--card);
        border: 1px solid var(--cream);
        border-radius: {{ S['card_r'][FMT] }}px;
        padding: 0 {{ S['card_px'][FMT] }}px;
        box-shadow: 0 10px 34px rgba(26, 26, 26, 0.06);
      }
      .ai-card-flag { font-size: {{ S['card_fs'][FMT] }}px; font-weight: 700; flex: none; }

      .ai-card-flag.is-up { color: var(--up); }
      .ai-card-flag.is-down, .ai-card-flag.is-alert { color: var(--accent); }
      .ai-card-text { font-size: {{ S['card_fs'][FMT] }}px; line-height: 1.3; color: var(--ink); }

      .ai-pills { display: flex; gap: 22px; margin-top: 60px; flex-wrap: wrap; }
      .ai-pill {
        display: inline-flex; align-items: center;
        border-radius: 999px;
        padding: 26px 54px;
        font-size: 32px; font-weight: 500;
      }
      .ai-pill.is-solid { background: var(--ink); color: var(--card); }
      .ai-pill.is-ghost { border: 1px solid var(--tan); color: var(--ink); }

      .ai-frame--brief, .ai-frame--intake, .ai-frame--funnel {
        display: flex; flex-direction: column; justify-content: center;
      }

{% if preview %}

      :root {
        --dw-orange: #FD4E00; --dw-cream: #E0DCC1; --dw-light-cream: #EAE5D1;
        --dw-tan: #ADAB9E; --dw-dark: #1A1A1A; --dw-line: #332f2c;

        --card-w: 260px;
      }
      .preview-grid {
        display: grid; grid-template-columns: repeat(auto-fill, var(--card-w));
        justify-content: start;
        gap: 22px; padding: 26px 30px 60px; background: var(--dw-dark); min-height: 100vh;
      }
      .preview-cell { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
      .preview-card {
        position: relative; width: 100%; aspect-ratio: {{ w }}/{{ h }};
        overflow: hidden; border-radius: 12px; border: 1px solid var(--dw-line);
      }

      .preview-card .scene-frame {
        position: absolute; inset: 0; width: {{ w }}px; height: {{ h }}px;
        transform-origin: top left; background: {{ theme.color_bg }};
      }

      .preview-progress { cursor: pointer; padding: 4px 0; margin: -4px 0;
        position: relative; height: 4px; border-radius: 999px;
        background: #2a2725; overflow: hidden;
      }
      .preview-progress i {
        position: absolute; inset: 0; transform-origin: left center;
        transform: scaleX(0); background: var(--dw-orange);
      }
      .preview-meta {
        display: flex; justify-content: space-between; gap: 8px;
        font: 500 10.5px/1 Inter, sans-serif; color: var(--dw-tan);
        letter-spacing: 0.01em;
      }
      .preview-label {
        position: absolute; top: 9px; left: 9px; z-index: 10;
        background: rgba(26,26,26,0.82); color: var(--dw-cream); padding: 5px 9px;
        border-radius: 5px; font: 700 10px/1 ui-monospace, monospace;
        letter-spacing: 0.05em;
      }
      .preview-play {
        position: absolute; bottom: 9px; right: 9px; z-index: 10;
        width: 36px; height: 36px; border-radius: 50%; border: none;
        background: rgba(234,229,209,0.92); cursor: pointer;
        display: flex; align-items: center; justify-content: center;
        font-size: 15px; color: var(--dw-dark); transition: transform 0.15s;
      }
      .preview-play:hover { transform: scale(1.15); }
      .preview-bar {
        position: sticky; top: 0; z-index: 50;
        display: flex; gap: 12px; align-items: center; flex-wrap: nowrap;
        padding: 14px 30px; background: var(--dw-dark);
        border-bottom: 1px solid var(--dw-line);
        font-family: Inter, sans-serif; color: var(--dw-cream);
      }
      .preview-bar button, .preview-bar span { white-space: nowrap; }
      .preview-logo { display: flex; align-items: center; gap: 9px; margin-right: 10px; flex: none; }
      .preview-logo span {
        font-family: 'Science Gothic', system-ui, sans-serif; font-weight: 500;
        font-size: 18px; letter-spacing: 0.016em; color: var(--dw-cream);
      }
      .preview-logo i {
        width: 8px; height: 8px; border-radius: 50%; background: var(--dw-orange);
      }
      .preview-title {
        font-family: 'Space Grotesk', Inter, sans-serif; font-weight: 600;
        font-size: 14px; color: var(--dw-light-cream); letter-spacing: -0.01em;
        overflow: hidden; text-overflow: ellipsis; min-width: 0;
      }
      .preview-bar button {
        border: 1px solid var(--dw-line); background: #232020; color: var(--dw-cream);
        padding: 7px 14px; border-radius: 8px; cursor: pointer;
        font-family: inherit; font-size: 12.5px;
      }
      .preview-bar button:hover { background: #2c2827; border-color: #443f3b; }
      .preview-bar button.on { background: var(--dw-orange); border-color: var(--dw-orange); color: #fff; }
      .preview-bar button[disabled] { opacity: 0.42; cursor: not-allowed; }
      .preview-bar button[disabled]:hover { background: #232020; border-color: var(--dw-line); }
      .preview-bar .spacer { flex: 1; }
      .preview-bar #bar-status { font-size: 12px; color: var(--dw-tan); }
      .preview-card.active { outline: 2px solid var(--dw-orange); outline-offset: 3px; }

      html, body { width: auto; height: auto; overflow: auto; background: var(--dw-dark); }
{% endif %}
    </style>

    <script>

      function fitFrames() {
        document.querySelectorAll('.preview-card').forEach(card => {
          const frame = card.querySelector('.scene-frame');
          if (!frame) return;
          frame.style.transform = `scale(${card.getBoundingClientRect().width / {{ w }}})`;
        });
      }

      const CARD_STEPS = [150, 190, 230, 260, 320, 400, 500, 640, 820];
      function applyCardWidth(px) {
        document.documentElement.style.setProperty('--card-w', px + 'px');
        try { localStorage.setItem('ugc-card-w', px); } catch (e) {  }
      }
      function resize(dir) {
        const now = parseInt(getComputedStyle(document.documentElement)
          .getPropertyValue('--card-w'), 10) || 260;
        let i = CARD_STEPS.findIndex(v => v >= now);
        if (i < 0) i = CARD_STEPS.length - 1;
        applyCardWidth(CARD_STEPS[Math.min(Math.max(i + dir, 0), CARD_STEPS.length - 1)]);
      }
      try {
        const saved = parseInt(localStorage.getItem('ugc-card-w'), 10);
        if (saved) applyCardWidth(saved);
      } catch (e) {  }

      let lastCardWidth = 0, lastCardCount = 0;
      function watchFit() {
        const cards = document.querySelectorAll('.preview-card');
        if (cards.length) {
          const w = cards[0].getBoundingClientRect().width;

          if (Math.abs(w - lastCardWidth) > 0.5 || cards.length !== lastCardCount) {
            lastCardWidth = w; lastCardCount = cards.length; fitFrames();
          }
        }
        requestAnimationFrame(watchFit);
      }
      requestAnimationFrame(watchFit);

      document.addEventListener('DOMContentLoaded', () => {
        fitFrames();
      });
    </script>
  </head>

  <body>
{% if preview %}

    <div class="preview-bar">
      <div class="preview-logo"><span>Digital Workers</span><i></i></div>
      <span class="preview-title">{{ project.name }}</span>
      <span class="spacer"></span>
      <button onclick="resize(-1)" title="Smaller frames">&minus;</button>
      <button onclick="resize(1)" title="Larger frames">+</button>
      <button id="btn-all" onclick="playAll()">&#9654; Play all</button>
      <button onclick="resetAll()" title="Back to the first frame">&#8634; Reset</button>
      <button id="btn-edit" onclick="toggleEdit()" title="Move and resize each scene's copy">&#9998; Edit layout</button>
      <button id="btn-save" onclick="edSaveAll()" hidden title="Write every changed scene to content.yaml">Save</button>
      <button id="btn-export" onclick="exportVideo()" title="Render this project's composed page to an mp4">&#8681; Export video</button>
      <button id="btn-export-watch" onclick="openExportModal()" hidden title="Reopen the last export without re-rendering it">&#9654; Watch video</button>
      <span id="export-status" hidden></span>
      <span id="bar-status">{{ scenes | length }} scenes &middot; {{ total_duration }}s</span>
    </div>

    <div class="preview-grid">
{% for scene in scenes %}
{% set idx = loop.index %}
      <div class="preview-cell">
      <div class="preview-card" data-scene="{{ idx }}">
        <div class="preview-label">{{ idx }}. {{ scene.type }}</div>
        <button class="preview-play" onclick="playScene({{ idx }})">&#9654;</button>

        <div class="scene-frame scene-solid">
{{ scene_body(scene, idx, 'pv' ~ idx) }}
        </div>
      </div>
        <div class="preview-progress" data-scene="{{ idx }}" onclick="progSeek(event, {{ idx }})" title="Play from here"><i></i></div>
        <div class="preview-meta">
          <span>{{ idx }}. {{ scene.type }}</span>
          <span>{{ scene.duration }}s</span>
        </div>
      </div>
{% endfor %}
    </div>

    <script>
      const sceneBuilders = {};
      const sceneTL = {};

{% for scene in scenes %}
{% set idx = loop.index %}
      sceneBuilders[{{ idx }}] = function() {
        const tl = gsap.timeline({ paused: true });

        let _cursor = 0;
        const seq = (t, d) => { const at = Math.max(t, _cursor); _cursor = at + d; return +at.toFixed(3); };

{{ scene_timeline(scene, idx, 'pv' ~ idx, 0, durations[loop.index0], true) }}
        return tl;
      };
{% endfor %}

      const SCENE_DURATIONS = {{ durations | tojson }};
      const IDLE_STATUS = '{{ scenes | length }} scenes \u00b7 {{ total_duration }}s';

      const HAS_AUDIO = false;
      let audioOn = false;
      let allTimer = null;
      let playing = false;

      const PROG = {};
      const SCENE_STATE = {};

      const progFill = idx =>
        document.querySelector(`.preview-progress[data-scene="${idx}"] i`);

      function progTick(idx) {
        const p = PROG[idx], fill = progFill(idx);
        if (!p || !fill) return;
        const elapsed = p.elapsed + (performance.now() - p.t0) / 1000;
        const frac = Math.min(elapsed / SCENE_DURATIONS[idx - 1], 1);
        fill.style.transform = `scaleX(${frac})`;
        if (frac < 1 && !p.paused) p.raf = requestAnimationFrame(() => progTick(idx));
      }

      function progPlay(idx, fromZero) {
        const p = PROG[idx] || (PROG[idx] = { elapsed: 0 });
        if (fromZero) p.elapsed = 0;
        cancelAnimationFrame(p.raf);
        p.paused = false;
        p.t0 = performance.now();
        progTick(idx);
      }

      function progPause(idx) {
        const p = PROG[idx];
        if (!p || p.paused) return;
        p.elapsed += (performance.now() - p.t0) / 1000;
        p.paused = true;
        cancelAnimationFrame(p.raf);
      }

      function resetProgress(idx) {
        const p = PROG[idx];
        if (p) { cancelAnimationFrame(p.raf); p.elapsed = 0; p.paused = true; }
        const fill = progFill(idx);
        if (fill) fill.style.transform = 'scaleX(0)';
      }

      function progSeek(event, idx) {
        const bar = event.currentTarget;
        const rect = bar.getBoundingClientRect();
        const frac = Math.min(Math.max((event.clientX - rect.left) / rect.width, 0), 1);
        const at = frac * SCENE_DURATIONS[idx - 1];

        sceneTL[idx] = buildSceneTL(idx);
        sceneTL[idx].seek(at);
        const vid = sceneVideo(idx);
        if (vid) {
          vid.muted = !audioOn;

          try { vid.currentTime = Math.min(at, vid.duration || at); } catch (e) {}
        }

        const p = PROG[idx] || (PROG[idx] = { elapsed: 0 });
        cancelAnimationFrame(p.raf);
        p.elapsed = at;
        const fill = progFill(idx);
        if (fill) fill.style.transform = `scaleX(${frac})`;

        sceneTL[idx].play();
        if (vid) vid.play().catch(() => {});
        progPlay(idx, false);
        SCENE_STATE[idx] = 'playing';
        playGlyph(idx, true);
      }

      function playGlyph(idx, playing) {
        const b = document.querySelector(`.preview-card[data-scene="${idx}"] .preview-play`);
        if (b) b.innerHTML = playing ? '&#10074;&#10074;' : '&#9654;';
      }

      function stopAll() {
        clearTimeout(allTimer);
        allTimer = null;
        playing = false;
        document.querySelectorAll('video').forEach(v => v.pause());
        document.querySelectorAll('.preview-card').forEach(c => c.classList.remove('active'));
        SCENE_DURATIONS.forEach((_, i) => {
          resetProgress(i + 1); SCENE_STATE[i + 1] = 'idle'; playGlyph(i + 1, false);
        });
        const b = document.getElementById('btn-all');
        b.classList.remove('on');
        b.innerHTML = '\u25B6 Play all';
        document.getElementById('bar-status').textContent = IDLE_STATUS;
      }

      function playAll(from = 1) {
        const total = SCENE_DURATIONS.length;

        if (playing && from === 1) { stopAll(); return; }
        if (from > total) { stopAll(); return; }
        if (from === 1) SCENE_DURATIONS.forEach((_, i) => resetProgress(i + 1));
        playing = true;
        const b = document.getElementById('btn-all');
        b.classList.add('on');
        b.innerHTML = '\u25A0 Stop';
        document.querySelectorAll('.preview-card').forEach(c => c.classList.remove('active'));
        const card = document.querySelector(`.preview-card[data-scene="${from}"]`);
        if (card) {
          card.classList.add('active');
          card.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
        document.getElementById('bar-status').textContent = `playing ${from} / ${total}`;
        startScene(from, false);
        allTimer = setTimeout(() => playAll(from + 1), SCENE_DURATIONS[from - 1] * 1000);
      }

      function playScene(idx) {
        const state = SCENE_STATE[idx] || 'idle';
        if (state === 'playing') return pauseScene(idx);
        if (state === 'paused') return resumeScene(idx);
        return startScene(idx);
      }

      function sceneVideo(idx) {
{% if stills %}
        return null;
{% else %}
        return document.getElementById('pv-bg' + idx);
{% endif %}
      }

      function cascadeTimeline(idx, tl) {
        const a = (typeof ANIMS !== 'undefined') ? ANIMS[idx - 1] : null;
        if (!a || !a.cascade) return tl;
        const delay = +a.delay || 0, start = +a.start || 0;

        const kids = tl.getChildren(false, true, true).filter(k => {
          const t = k.targets && k.targets()[0];
          const id = t && t.id ? String(t.id) : '';
          return !id.endsWith('-scrim');
        });
        kids.forEach((k, i) => k.startTime(start + i * delay));
        return tl;
      }

      function buildSceneTL(idx) {
        if (sceneTL[idx]) { sceneTL[idx].revert(); delete sceneTL[idx]; }
        return cascadeTimeline(idx, sceneBuilders[idx]());
      }

      function replayScene(idx) {
        sceneTL[idx] = buildSceneTL(idx);
        const vid = sceneVideo(idx);
        if (vid) { vid.muted = !audioOn; vid.currentTime = 0; vid.play().catch(() => {}); }
        sceneTL[idx].play(0);
        progPlay(idx, true);
        SCENE_STATE[idx] = 'playing';
        playGlyph(idx, true);
      }

      function startScene(idx, exclusive = true) {

        if (exclusive) {
          SCENE_DURATIONS.forEach((_, i) => {
            const other = i + 1;
            if (other === idx || (SCENE_STATE[other] || 'idle') === 'idle') return;
            if (sceneTL[other]) sceneTL[other].pause();
            const ov = sceneVideo(other);
            if (ov) ov.pause();
            resetProgress(other);
            SCENE_STATE[other] = 'idle';
            playGlyph(other, false);
          });
        }

        sceneTL[idx] = buildSceneTL(idx);
        const vid = sceneVideo(idx);
        if (vid) { vid.muted = !audioOn; vid.currentTime = 0; vid.play().catch(() => {}); }
        sceneTL[idx].play();
        progPlay(idx, true);
        SCENE_STATE[idx] = 'playing';
        playGlyph(idx, true);
      }

      function pauseScene(idx) {
        if (sceneTL[idx]) sceneTL[idx].pause();
        const vid = sceneVideo(idx);
        if (vid) vid.pause();
        progPause(idx);
        SCENE_STATE[idx] = 'paused';
        playGlyph(idx, false);
      }

      function resumeScene(idx) {
        if (sceneTL[idx]) sceneTL[idx].resume();
        const vid = sceneVideo(idx);
        if (vid) { vid.muted = !audioOn; vid.play().catch(() => {}); }
        progPlay(idx, false);
        SCENE_STATE[idx] = 'playing';
        playGlyph(idx, true);
      }

      function resetAll() {
        stopAll();
        SCENE_DURATIONS.forEach((_, i) => {
          const idx = i + 1;
          if (sceneTL[idx]) { sceneTL[idx].revert(); delete sceneTL[idx]; }
          const vid = sceneVideo(idx);
          if (vid) { vid.pause(); vid.currentTime = 0; }
          resetProgress(idx);
          SCENE_STATE[idx] = 'idle';
          playGlyph(idx, false);
        });
        document.getElementById('bar-status').textContent = IDLE_STATUS;
      }

    </script>

{% else %}

    <div
      id="root"
      data-composition-id="main"
      data-start="0"
      data-duration="{{ total_duration }}"
      data-width="{{ w }}"
      data-height="{{ h }}"
    >

{% for scene in scenes %}
{% set idx = loop.index %}
      <div
        id="shot{{ idx }}"
        class="clip scene-solid"
        data-start="{{ starts[loop.index0] }}"
        data-duration="{{ durations[loop.index0] }}"
        data-track-index="1"
      >
{{ scene_body(scene, idx, 's' ~ idx) }}
      </div>
{% endfor %}
    </div>

    <script>
      window.__timelines = window.__timelines || {};
      const tl = gsap.timeline({ paused: true });

{% for scene in scenes %}
{% set idx = loop.index %}
      {

      let _cursor = {{ starts[loop.index0] }};
      const seq = (t, d) => { const at = Math.max(t, _cursor); _cursor = at + d; return +at.toFixed(3); };

{{ scene_timeline(scene, idx, 's' ~ idx, starts[loop.index0], durations[loop.index0], false) }}
      }
{% endfor %}

      window.__timelines["main"] = tl;
    </script>
{% endif %}
  </body>
</html>
