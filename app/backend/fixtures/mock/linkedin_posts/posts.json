      ],
      "id": "7241000000000000011",
      "num_comments": 26,
      "num_likes": 289,
      "num_shares": 10,
      "post_text": "85% of the feed is watched muted, which means the caption is the ad and not a courtesy. Burned in, high contrast, three to five words on screen, placed above the interface furniture. That is it. That is the post.",
      "post_type": "post",
      "url": "https://www.linkedin.com/posts/clipwise_activity-7241000000000000011",
      "user_followers": 9600,
      "user_id": "https://www.linkedin.com/company/clipwise"
    },
    "source_id": "7241000000000000011"
  },
  {
    "payload": {
      "_competitor_ref": "clipwise.io",
      "date_posted": "2026-08-24T14:05:00.000Z",
      "hashtags": [
        "#clipwise",
