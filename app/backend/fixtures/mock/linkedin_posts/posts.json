      ],
      "id": "7241000000000000014",
      "num_comments": 25,
      "num_likes": 176,
      "num_shares": 7,
      "post_text": "German runs about 20% longer than English and Japanese runs shorter, so a thirty-second ad becomes a thirty-six and a twenty-six unless somebody rewrites rather than translates. We rewrite. It is slower and it is the only thing that works.",
      "post_type": "post",
      "url": "https://www.linkedin.com/posts/avatarly_activity-7241000000000000014",
      "user_followers": 12700,
      "user_id": "https://www.linkedin.com/company/avatarly"
    },
