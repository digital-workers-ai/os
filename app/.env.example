# Copy to app/.env. Every value here is intentionally blank.
#
# A blank value reads as unset, so the stand-in answers and the suites stay
# hermetic. CI copies this file verbatim, which is why no placeholder text
# may appear on the right of an '=' — a non-empty value would resolve real
# credentials and point the connectors at live vendor hosts.
#
# Per source it is all or nothing: set every variable a source names, or
# none of them. A partial set raises CredentialsError naming what is missing.
# Each source also accepts <SOURCE>_BASE_URL as an optional host override.

# Forces every source to resolve to its stand-in whatever else is set here.
# The snapshot stack sets this; leave it blank to let the variables below work.
STAND_INS_ONLY=false

# activecampaign — host comes from ACTIVECAMPAIGN_BASE_URL
ACTIVECAMPAIGN_BASE_URL=
ACTIVECAMPAIGN_API_KEY=

# amplitude — https://amplitude.com
AMPLITUDE_API_KEY=
AMPLITUDE_SECRET_KEY=

# calendly — https://api.calendly.com
CALENDLY_ACCESS_TOKEN=
CALENDLY_USER_URI=

# chatgpt, perplexity, gemini, google_ads_transparency — https://openrouter.ai
OPENROUTER_API_KEY=

# google_serp, google_ads_transparency — https://serpapi.com
SERPAPI_API_KEY=

# hubspot — https://api.hubapi.com
HUBSPOT_ACCESS_TOKEN=

# intercom — https://api.intercom.io
INTERCOM_ACCESS_TOKEN=

# klaviyo — https://a.klaviyo.com
KLAVIYO_API_KEY=

# linkedin_posts — https://api.brightdata.com
BRIGHTDATA_API_KEY=

# mailchimp — https://{dc}.api.mailchimp.com
MAILCHIMP_API_KEY=

# mixpanel — https://data.mixpanel.com
MIXPANEL_SERVICE_ACCOUNT_USERNAME=
MIXPANEL_SERVICE_ACCOUNT_SECRET=
MIXPANEL_PROJECT_ID=

# shopify — https://{domain}
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ACCESS_TOKEN=

# stripe — https://api.stripe.com
STRIPE_API_KEY=

# twilio — https://api.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=

# twitter — https://api.x.com
TWITTER_BEARER_TOKEN=
TWITTER_USER_ID=
